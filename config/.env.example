# Angel Organics chatbot backend configuration
# Copy to backend/.env and fill in your key.

# Groq API key (free): https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: force a specific Groq model. Leave unset to pick automatically.
# GROQ_MODEL=openai/gpt-oss-20b

# Optional: local server settings
PORT=5000
FLASK_ENV=development
